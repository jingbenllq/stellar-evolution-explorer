! ==============================================================================
! MESA inlist_project Template: Massive Stars (15.0 - 25.0 M_sun)
! Evolves through H -> He -> C -> Ne -> O -> Si burning to Fe-core infall (CCSN)
! ==============================================================================

&star_job
    create_pre_main_sequence_model = .true.
    pre_ms_T_c = 5.0d5

    save_model_when_terminate = .true.
    save_model_filename = 'pre_ccsn.mod'

    ! 21-isotope alpha-chain network from H through Fe/Ni core collapse
    change_net = .true.
    new_net_name = 'approx21.net'

    use_Type2_opacities = .true.
    Zbase = 0.01400d0

    pgstar_flag = .false.
/ ! end of star_job namelist


&eos
/ ! end of eos namelist


&kap
    Zbase = 0.01400d0
    kap_file_prefix = 'a09'
/ ! end of kap namelist


&controls
    ! --------------------------------------------------------------------------
    ! 1. Initial Parameter Space Coordinates
    ! --------------------------------------------------------------------------
    initial_mass = 25.00d0
    initial_z = 0.01400d0
    initial_y = 0.26856d0

    ! --------------------------------------------------------------------------
    ! 2. Convection, Ledoux, Semiconvection & Overshooting
    ! --------------------------------------------------------------------------
    mixing_length_alpha = 1.5d0
    use_Ledoux_criterion = .true.
    alpha_semiconvection = 0.01d0

    overshoot_scheme(1) = 'exponential'
    overshoot_zone_type(1) = 'any'
    overshoot_zone_loc(1) = 'core'
    overshoot_bdy_loc(1) = 'top'
    overshoot_f(1) = 0.0160d0
    overshoot_f0(1) = 0.004d0

    ! --------------------------------------------------------------------------
    ! 3. Massive Star Winds (Dutch scheme: Vink + de Jager + Nugis & Lamers)
    ! --------------------------------------------------------------------------
    hot_wind_scheme = 'Dutch'
    cool_wind_RGB_scheme = 'Dutch'
    cool_wind_AGB_scheme = 'Dutch'
    Dutch_scaling_factor = 0.8d0

    ! --------------------------------------------------------------------------
    ! 4. Advanced Burning Resolution & Core Collapse Stopping Condition
    ! --------------------------------------------------------------------------
    varcontrol_target = 1d-3
    mesh_delta_coeff = 0.8d0

    ! Terminate when iron core infall velocity reaches 1000 km/s (Core Collapse)
    fe_core_infall_limit = 1d8     ! cm/s

    history_interval = 2
    profile_interval = 25
    max_num_profile_models = 120
    terminal_interval = 10
/ ! end of controls namelist
