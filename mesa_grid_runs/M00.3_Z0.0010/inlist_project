! ==============================================================================
! MESA inlist_project Template: Low-to-Intermediate Mass Stars (0.3 - 8.0 M_sun)
! Evolves from Pre-Main Sequence -> ZAMS -> TAMS -> RGB -> HB -> AGB -> WD
! ==============================================================================

&star_job
    ! Starting model: create pre-main-sequence model
    create_pre_main_sequence_model = .true.
    pre_ms_T_c = 3.0d5

    ! Save final model when simulation terminates
    save_model_when_terminate = .true.
    save_model_filename = 'final_model.mod'

    ! Nuclear reaction network suitable for H, He, and C/O burning
    change_net = .true.
    new_net_name = 'co_burn.net'

    ! Opacity tables configured for C/O enhancement during He burning
    use_Type2_opacities = .true.
    Zbase = 0.00100d0

    ! Display pgstar live dashboard if enabled
    pgstar_flag = .false.
/ ! end of star_job namelist


&eos
    ! Standard MESA Equation of State (OPAL + SCVH + MacDonald + HELM + PC)
/ ! end of eos namelist


&kap
    Zbase = 0.00100d0
    kap_file_prefix = 'a09'
    kap_lowT_prefix = 'lowT_fa05_a09p'
    kap_CO_prefix = 'a09_co'
/ ! end of kap namelist


&controls
    ! --------------------------------------------------------------------------
    ! 1. Initial Parameter Space Coordinates
    ! --------------------------------------------------------------------------
    initial_mass = 0.30d0
    initial_z = 0.00100d0
    initial_y = 0.24854d0

    ! --------------------------------------------------------------------------
    ! 2. Convection & Mixing Physics
    ! --------------------------------------------------------------------------
    mixing_length_alpha = 2.0d0
    use_Ledoux_criterion = .true.
    alpha_semiconvection = 0.01d0
    thermohaline_coeff = 2.0d0

    ! Exponential convective core overshooting (important for M >= 1.2 M_sun)
    overshoot_scheme(1) = 'exponential'
    overshoot_zone_type(1) = 'any'
    overshoot_zone_loc(1) = 'core'
    overshoot_bdy_loc(1) = 'top'
    overshoot_f(1) = 0.0000d0
    overshoot_f0(1) = 0.004d0

    ! --------------------------------------------------------------------------
    ! 3. Stellar Winds (Reimers on RGB + Bloecker on AGB)
    ! --------------------------------------------------------------------------
    cool_wind_RGB_scheme = 'Reimers'
    Reimers_scaling_factor = 0.5d0
    cool_wind_AGB_scheme = 'Bloecker'
    Bloecker_scaling_factor = 0.1d0
    RGB_to_AGB_wind_switch = 1d-4

    ! --------------------------------------------------------------------------
    ! 4. Stopping Conditions & Output Intervals
    ! --------------------------------------------------------------------------
    max_age = 1.4d10               ! Hubble time cap (years) for 0.3 M_sun
    max_model_number = 30000
    gamma_center_limit = 20.0d0    ! Stop once white dwarf core cools & crystallizes

    history_interval = 5
    profile_interval = 50
    max_num_profile_models = 100
    terminal_interval = 20
/ ! end of controls namelist
