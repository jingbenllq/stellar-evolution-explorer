! ==============================================================================
! MESA history_columns.list for Parameter Space Stellar Evolution Analysis
! ==============================================================================

   model_number
   star_age
   star_mass
   star_mdot

   ! Surface / H-R Diagram Quantities
   log_L
   log_Teff
   log_R
   log_g

   ! Central Conditions (rho_c - T_c Phase Diagram)
   log_center_T
   log_center_Rho
   log_center_P
   center_degeneracy        ! electron chemical potential / k_B T (eta)
   center_gamma

   ! Nuclear Luminosities (erg/s in log10)
   log_LH                   ! Total H-burning luminosity
   log_LHe                  ! Total He-burning luminosity
   log_LZ                   ! Total metal (C/Ne/O/Si) burning luminosity
   log_Lneu                 ! Neutrino loss luminosity
   pp                       ! log10(L_pp / L_sun)
   cno                      ! log10(L_cno / L_sun)
   tri_alfa                 ! log10(L_3alpha / L_sun)

   ! Central Element Mass Fractions
   center_h1
   center_he4
   center_c12
   center_n14
   center_o16
   center_ne20
   center_mg24
   center_si28
   center_fe56

   ! Core Masses (for Kippenhahn & Remnant Analysis)
   he_core_mass
   co_core_mass
   one_core_mass
   fe_core_mass

   ! Convection & Burning Regions (for Kippenhahn Diagram)
   mixing_regions 20
   burning_regions 20
