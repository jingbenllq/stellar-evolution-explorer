! ==============================================================================
! MESA profile_columns.list for Internal Structure & Onion-Skin Comparison
! ==============================================================================

   zone
   mass                     ! Enclosed mass m (M_sun)
   q                        ! Fractional mass m / M_star
   logR                     ! log10(r / R_sun)
   logT                     ! log10(T / K)
   logRho                   ! log10(rho / g cm^-3)
   logP                     ! log10(P / dyn cm^-2)

   ! Energy Generation & Neutrino Cooling (erg g^-1 s^-1)
   eps_nuc
   non_nuc_neu
   eps_grav

   ! Mixing & Convection Indicators
   mixing_type              ! 0=no_mixing, 1=convective, 2=overshoot, 3=semiconvective
   gradT
   gradr
   grada
   opacity

   ! Chemical Abundances (Mass Fractions X_i)
   h1
   he3
   he4
   c12
   n14
   o16
   ne20
   mg24
   si28
   s32
   ar36
   ca40
   ti44
   cr48
   fe52
   fe54
   fe56
   ni56
